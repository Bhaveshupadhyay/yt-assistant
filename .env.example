# Application Settings
APP_NAME="The Lenny Growth Assistant"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="development"

# Database Configuration (Async connection: SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./lenny_assistant.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/lenny_assistant"
DATABASE_ECHO=false

# Vector Store (Qdrant: local container on port 6333 or Qdrant Cloud URL)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="lenny_transcripts"

# Local LLM (Ollama daemon on http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"

# Cloud LLM Provider API Keys (Optional if using local Ollama)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="json"

